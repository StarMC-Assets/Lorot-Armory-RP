{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "on_shelf"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:component",
          "component": "minecraft:custom_name",
          "cases": [
            {
              "when": "M3 Bulwark Blast Shield",
              "model": {
                "type": "minecraft:model",
                "model": "lorotarmory:item/shields/bulwark_shield/shield_icon"
              }
            },
            {
              "when": "Droid commando personal shield",
              "model": {
                "type": "minecraft:model",
                "model": "lorotarmory:item/shields/bx_shield/shield_icon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:special",
            "model": {
              "type": "minecraft:shield"
            },
            "base": "item/shield"
          }
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand",
          "thirdperson_righthand",
          "thirdperson_lefthand",
          "fixed"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:component",
          "component": "minecraft:custom_name",
          "cases": [
            {
              "when": "M3 Bulwark Blast Shield",
              "model": {
                "type": "minecraft:condition",
                "property": "minecraft:using_item",
                "on_true": {
                  "type": "minecraft:model",
                  "model": "lorotarmory:item/shields/bulwark_shield/shield_blocking"
                },
                "on_false": {
                  "type": "minecraft:model",
                  "model": "lorotarmory:item/shields/bulwark_shield/shield"
                }
              }
            },
            {
              "when": "Droid commando personal shield",
              "model": {
                "type": "minecraft:condition",
                "property": "minecraft:using_item",
                "on_true": {
                  "type": "minecraft:model",
                  "model": "lorotarmory:item/shields/bx_shield/shield_blocking"
                },
                "on_false": {
                  "type": "minecraft:model",
                  "model": "lorotarmory:item/shields/bx_shield/shield"
                }
              }
            }
          ],
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:special",
              "model": {
                "type": "minecraft:shield"
              },
              "base": "item/shield_blocking"
            },
            "on_false": {
              "type": "minecraft:special",
              "model": {
                "type": "minecraft:shield"
              },
              "base": "item/shield"
            }
          }
        }
      }
    ]
  }
}